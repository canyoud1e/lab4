#include <iostream>
#include <cstdlib>
using namespace std;

int main() {
    int n, a[100];
    cin >> n;
    
    for(int i = 0; i < n; i++) {
        a[i] = rand() % 41 - 20;
        cout << a[i] << " ";
    }
    cout << endl;

    int mn = a[0], mx = a[0];
    for(int i = 1; i < n; i++) {
        if(a[i] < mn) mn = a[i];
        if(a[i] > mx) mx = a[i];
    }

    cout << mn * mx << endl;

    return 0;
}
