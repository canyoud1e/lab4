#include <iostream>
#include <cstdlib>
using namespace std;

int main() {
    int n, a[100];
    cin >> n;
    
    for(int i = 0; i < n; i++) {
        a[i] = rand() % 41 - 20;
        cout << a[i] << " ";
    }
    cout << endl;

    int p = 1;
    bool flag = false;
    for(int i = 0; i < n; i++) {
        if(a[i] < 0) {
            p *= a[i];
            flag = true;
        }
    }

    if(flag) cout << p << endl;
    else cout << 0 << endl;

    return 0;
}
